    {"keys": ["re:\\b(?:voz|voces|vocals?|cantar)\\b"], "caption_keys": ["re:\\b(?:vocals?|sung|rapped|choir)\\b"]},
    {"keys": ["re:\\b(?:bajos?|bass|bassline)\\b"], "caption_keys": ["re:\\b(?:bass|sub-bass|bassline)\\b"]},
    {"keys": ["re:\\b(?:pianos?)\\b"], "caption_keys": ["re:\\bpianos?\\b"]},
