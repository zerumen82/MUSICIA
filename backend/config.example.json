{
  "host": "127.0.0.1",
  "port": 8000,
  "log_level": "INFO",
  "cors_origins": ["http://localhost:5173", "http://127.0.0.1:5173"],
  "acestep": {
    "base_url": "http://127.0.0.1:8001",
